# -------------------------------------------------------------
# THE LENNY GROWTH ASSISTANT — ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# PostgreSQL Connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lenny_growth_db

# Local Inference (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=90.0

# Cloud Inference Options (gemini / anthropic / openai)
DEFAULT_PROVIDER=local
CLOUD_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLOUD_MODEL_NAME=gemini-2.5-flash

# RAG & Transcript Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
MIN_RELEVANCE_SCORE=0.22
